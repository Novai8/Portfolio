[
 {
  "start": 0.0,
  "end": 3.5,
  "lines": [
   "Quick question. How many times have you",
   "opened a recruitment email thread"
  ]
 },
 {
  "start": 3.5,
  "end": 7.2,
  "lines": [
   "and thought, okay,",
   "what's the latest here?"
  ]
 },
 {
  "start": 7.4,
  "end": 10.6,
  "lines": [
   "Because in search,",
   "the inbox isn't just email."
  ]
 },
 {
  "start": 10.8,
  "end": 12.6,
  "lines": [
   "It's the whole project."
  ]
 },
 {
  "start": 12.7,
  "end": 17.4,
  "lines": [
   "You've got client updates, candidate",
   "replies, scheduling changes, feedback loops,"
  ]
 },
 {
  "start": 17.5,
  "end": 19.6,
  "lines": [
   "salary notes, interview logistics,"
  ]
 },
 {
  "start": 19.8,
  "end": 25.3,
  "lines": [
   "all buried inside long threads",
   "with Re: Re: Re: everywhere."
  ]
 },
 {
  "start": 25.9,
  "end": 30.6,
  "lines": [
   "And the real work isn't reading one email.",
   "It's reconstructing the timeline,"
  ]
 },
 {
  "start": 31.0,
  "end": 34.8,
  "lines": [
   "figuring out what's been decided",
   "and what needs to happen next."
  ]
 },
 {
  "start": 35.0,
  "end": 36.8,
  "lines": [
   "And that's where things slip."
  ]
 },
 {
  "start": 37.0,
  "end": 40.0,
  "lines": [
   "A client asks for an updated shortlist",
   "and it gets missed."
  ]
 },
 {
  "start": 40.2,
  "end": 43.8,
  "lines": [
   "A candidate replies with availability",
   "and nobody confirms."
  ]
 },
 {
  "start": 44.0,
  "end": 46.8,
  "lines": [
   "A stakeholder gives feedback",
   "and it doesn't get logged."
  ]
 },
 {
  "start": 47.0,
  "end": 52.6,
  "lines": [
   "Not because anyone's careless, because it's",
   "too easy to lose the next action in a wall of text."
  ]
 },
 {
  "start": 53.1,
  "end": 54.4,
  "lines": [
   "Here's the cleaner way."
  ]
 },
 {
  "start": 54.5,
  "end": 59.7,
  "lines": [
   "The workflow watches your search inbox and",
   "processes threads at the conversation level,"
  ]
 },
 {
  "start": 59.8,
  "end": 61.9,
  "lines": [
   "not just individual messages."
  ]
 },
 {
  "start": 62.2,
  "end": 65.7,
  "lines": [
   "When something changes in a thread,",
   "it creates a concise summary."
  ]
 },
 {
  "start": 65.9,
  "end": 69.5,
  "lines": [
   "What's new, what's been decided,",
   "and what's still pending."
  ]
 },
 {
  "start": 69.8,
  "end": 73.3,
  "lines": [
   "Then it pulls out next actions",
   "like schedule interview,"
  ]
 },
 {
  "start": 73.5,
  "end": 77.4,
  "lines": [
   "send CV, request feedback,",
   "confirm availability,"
  ]
 },
 {
  "start": 77.6,
  "end": 82.1,
  "lines": [
   "and turns them into a simple task list",
   "with owners and due dates."
  ]
 },
 {
  "start": 82.4,
  "end": 85.9,
  "lines": [
   "No rewriting, no manual",
   "copy paste into a tracker."
  ]
 },
 {
  "start": 86.2,
  "end": 88.6,
  "lines": [
   "It can also draft the next reply for you."
  ]
 },
 {
  "start": 88.8,
  "end": 91.9,
  "lines": [
   "Short, professional, and grounded",
   "in the thread context."
  ]
 },
 {
  "start": 92.0,
  "end": 94.7,
  "lines": [
   "So you're not starting from",
   "a blank screen every time."
  ]
 },
 {
  "start": 95.0,
  "end": 96.9,
  "lines": [
   "But it doesn't send anything blindly."
  ]
 },
 {
  "start": 97.2,
  "end": 98.6,
  "lines": [
   "You stay in control."
  ]
 },
 {
  "start": 98.8,
  "end": 104.1,
  "lines": [
   "If the AI is uncertain, like mixed intent,",
   "conflicting dates, or unclear feedback,"
  ]
 },
 {
  "start": 104.3,
  "end": 107.3,
  "lines": [
   "it flags the thread for human review",
   "instead of guessing."
  ]
 },
 {
  "start": 107.6,
  "end": 110.4,
  "lines": [
   "You approve, edit, or reject."
  ]
 },
 {
  "start": 110.7,
  "end": 115.9,
  "lines": [
   "And everything is logged so you have a clear",
   "audit trail of what the workflow summarized and why."
  ]
 },
 {
  "start": 116.5,
  "end": 117.7,
  "lines": [
   "And this is important."
  ]
 },
 {
  "start": 117.9,
  "end": 120.2,
  "lines": [
   "It's job-related and evidence-based."
  ]
 },
 {
  "start": 120.5,
  "end": 123.0,
  "lines": [
   "It summarizes what's actually in the thread."
  ]
 },
 {
  "start": 123.2,
  "end": 125.8,
  "lines": [
   "If something isn't stated,",
   "it doesn't invent it."
  ]
 },
 {
  "start": 126.0,
  "end": 128.7,
  "lines": [
   "Quick estimate,",
   "illustrative assumptions only."
  ]
 },
 {
  "start": 128.9,
  "end": 133.9,
  "lines": [
   "If it takes about three minutes to read,",
   "interpret, and update notes for a busy thread,"
  ]
 },
 {
  "start": 134.1,
  "end": 136.9,
  "lines": [
   "and this reduces that",
   "to about one minute of review,"
  ]
 },
 {
  "start": 137.1,
  "end": 139.6,
  "lines": [
   "that's about two minutes saved per thread."
  ]
 },
 {
  "start": 140.0,
  "end": 143.8,
  "lines": [
   "At 200 threads a month,",
   "that's roughly 400 minutes,"
  ]
 },
 {
  "start": 144.0,
  "end": 146.0,
  "lines": [
   "around 6.7 hours saved."
  ]
 },
 {
  "start": 146.2,
  "end": 149.1,
  "lines": [
   "Again, assumptions,",
   "not a guaranteed result."
  ]
 },
 {
  "start": 149.6,
  "end": 151.6,
  "lines": [
   "Independent portfolio prototype."
  ]
 },
 {
  "start": 151.9,
  "end": 155.7,
  "lines": [
   "Fictional data, results vary,",
   "but the benefit is real."
  ]
 },
 {
  "start": 156.0,
  "end": 158.6,
  "lines": [
   "Fewer missed next steps,",
   "cleaner handoffs,"
  ]
 },
 {
  "start": 158.8,
  "end": 163.2,
  "lines": [
   "and an inbox that behaves like an organized",
   "search system, not a memory test."
  ]
 }
]