[
 {
  "i": 0,
  "w0": 0,
  "w1": 10,
  "start": 0.0,
  "end": 4.53,
  "text": "I need you to imagine this: it's 2:07 a.m., my laptop"
 },
 {
  "i": 1,
  "w0": 11,
  "w1": 19,
  "start": 4.54,
  "end": 7.14,
  "text": "is balanced on a laundry basket, and I'm eating"
 },
 {
  "i": 2,
  "w0": 20,
  "w1": 25,
  "start": 7.15,
  "end": 8.7,
  "text": "cereal out of a coffee mug\u2026"
 },
 {
  "i": 3,
  "w0": 26,
  "w1": 30,
  "start": 8.7,
  "end": 11.48,
  "text": "because I'm an entrepreneur now."
 },
 {
  "i": 4,
  "w0": 31,
  "w1": 37,
  "start": 12.46,
  "end": 14.7,
  "text": "I had just launched my first \"real\""
 },
 {
  "i": 5,
  "w0": 38,
  "w1": 45,
  "start": 14.71,
  "end": 17.85,
  "text": "business: a tiny online shop selling custom productivity"
 },
 {
  "i": 6,
  "w0": 46,
  "w1": 48,
  "start": 17.85,
  "end": 18.91,
  "text": "planners for freelancers."
 },
 {
  "i": 7,
  "w0": 49,
  "w1": 54,
  "start": 19.01,
  "end": 21.92,
  "text": "Nothing fancy\u2014just clean designs, funny prompts,"
 },
 {
  "i": 8,
  "w0": 55,
  "w1": 60,
  "start": 21.93,
  "end": 25.92,
  "text": "and the occasional passive-aggressive sticker like"
 },
 {
  "i": 9,
  "w0": 61,
  "w1": 66,
  "start": 25.93,
  "end": 29.12,
  "text": "\"Did you actually send that invoice?\""
 },
 {
  "i": 10,
  "w0": 67,
  "w1": 75,
  "start": 30.21,
  "end": 33.67,
  "text": "I refresh my store dashboard one more time, expecting"
 },
 {
  "i": 11,
  "w0": 76,
  "w1": 86,
  "start": 33.68,
  "end": 37.89,
  "text": "the usual: one order, maybe two if my mom gets excited."
 },
 {
  "i": 12,
  "w0": 87,
  "w1": 90,
  "start": 38.85,
  "end": 40.64,
  "text": "Then my screen updates."
 },
 {
  "i": 13,
  "w0": 91,
  "w1": 94,
  "start": 40.64,
  "end": 41.99,
  "text": "And I see it."
 },
 {
  "i": 14,
  "w0": 95,
  "w1": 97,
  "start": 41.99,
  "end": 43.87,
  "text": "A single order."
 },
 {
  "i": 15,
  "w0": 98,
  "w1": 100,
  "start": 43.87,
  "end": 46.95,
  "text": "For 500 planners."
 },
 {
  "i": 16,
  "w0": 101,
  "w1": 110,
  "start": 46.95,
  "end": 54.77,
  "text": "Total: $12,480. I just stare at it like it's going"
 },
 {
  "i": 17,
  "w0": 111,
  "w1": 117,
  "start": 54.78,
  "end": 56.52,
  "text": "to apologize and turn into a typo."
 },
 {
  "i": 18,
  "w0": 118,
  "w1": 125,
  "start": 58.22,
  "end": 63.56,
  "text": "\"Five\u2026 hundred?\" My heart starts doing parkour in"
 },
 {
  "i": 19,
  "w0": 126,
  "w1": 132,
  "start": 63.57,
  "end": 66.42,
  "text": "my chest. I'm not a business owner."
 },
 {
  "i": 20,
  "w0": 133,
  "w1": 140,
  "start": 66.42,
  "end": 69.33,
  "text": "I'm a person with Wi\u2011Fi and a dream."
 },
 {
  "i": 21,
  "w0": 141,
  "w1": 148,
  "start": 70.35,
  "end": 73.27,
  "text": "I click into the details, already mentally spending"
 },
 {
  "i": 22,
  "w0": 149,
  "w1": 154,
  "start": 73.28,
  "end": 75.08,
  "text": "the profit on adult things like\u2026"
 },
 {
  "i": 23,
  "w0": 155,
  "w1": 159,
  "start": 75.08,
  "end": 76.89,
  "text": "a chair with lumbar support."
 },
 {
  "i": 24,
  "w0": 160,
  "w1": 165,
  "start": 78.35,
  "end": 80.57,
  "text": "The customer name is \"Elliot Graye.\""
 },
 {
  "i": 25,
  "w0": 166,
  "w1": 169,
  "start": 81.22,
  "end": 82.59,
  "text": "The email looks legit."
 },
 {
  "i": 26,
  "w0": 170,
  "w1": 172,
  "start": 82.59,
  "end": 84.26,
  "text": "The payment cleared."
 },
 {
  "i": 27,
  "w0": 173,
  "w1": 179,
  "start": 84.95,
  "end": 87.09,
  "text": "And then I see the shipping address."
 },
 {
  "i": 28,
  "w0": 180,
  "w1": 188,
  "start": 87.09,
  "end": 90.44,
  "text": "It's an industrial street on the edge of town."
 },
 {
  "i": 29,
  "w0": 189,
  "w1": 191,
  "start": 90.44,
  "end": 92.23,
  "text": "No suite number."
 },
 {
  "i": 30,
  "w0": 192,
  "w1": 194,
  "start": 92.23,
  "end": 93.69,
  "text": "No business name."
 },
 {
  "i": 31,
  "w0": 195,
  "w1": 198,
  "start": 93.69,
  "end": 95.53,
  "text": "Just a street address."
 },
 {
  "i": 32,
  "w0": 199,
  "w1": 204,
  "start": 97.19,
  "end": 98.67,
  "text": "I zoom in on the map."
 },
 {
  "i": 33,
  "w0": 205,
  "w1": 208,
  "start": 98.67,
  "end": 101.96,
  "text": "It's\u2026 an abandoned warehouse."
 },
 {
  "i": 34,
  "w0": 209,
  "w1": 212,
  "start": 101.96,
  "end": 104.79,
  "text": "Not \"cool startup loft\""
 },
 {
  "i": 35,
  "w0": 213,
  "w1": 220,
  "start": 104.8,
  "end": 108.69,
  "text": "warehouse. Like, \"a raccoon probably pays rent here\""
 },
 {
  "i": 36,
  "w0": 221,
  "w1": 229,
  "start": 108.7,
  "end": 112.88,
  "text": "warehouse. I feel the excitement drain out of me"
 },
 {
  "i": 37,
  "w0": 230,
  "w1": 234,
  "start": 112.89,
  "end": 114.53,
  "text": "like someone pulled the plug."
 },
 {
  "i": 38,
  "w0": 235,
  "w1": 242,
  "start": 114.53,
  "end": 119.55,
  "text": "Because there are only two possibilities: One: a"
 },
 {
  "i": 39,
  "w0": 243,
  "w1": 246,
  "start": 119.56,
  "end": 121.94,
  "text": "mysterious billionaire loves planners."
 },
 {
  "i": 40,
  "w0": 247,
  "w1": 254,
  "start": 121.94,
  "end": 127.23,
  "text": "Two: I am about to get spectacularly scammed."
 },
 {
  "i": 41,
  "w0": 255,
  "w1": 261,
  "start": 128.47,
  "end": 132.7,
  "text": "Okay. Three possibilities: maybe the raccoon is"
 },
 {
  "i": 42,
  "w0": 262,
  "w1": 267,
  "start": 132.71,
  "end": 135.88,
  "text": "the billionaire. I email the customer."
 },
 {
  "i": 43,
  "w0": 268,
  "w1": 275,
  "start": 136.71,
  "end": 139.9,
  "text": "\"Hey Elliot! Huge thanks for your order\u2014just confirming"
 },
 {
  "i": 44,
  "w0": 276,
  "w1": 282,
  "start": 139.91,
  "end": 141.99,
  "text": "delivery details for such a large shipment.\""
 },
 {
  "i": 45,
  "w0": 283,
  "w1": 289,
  "start": 141.99,
  "end": 145.77,
  "text": "Five minutes later, a reply pops in."
 },
 {
  "i": 46,
  "w0": 290,
  "w1": 294,
  "start": 145.77,
  "end": 150.19,
  "text": "\"Ship ASAP. Need by Friday."
 },
 {
  "i": 47,
  "w0": 295,
  "w1": 297,
  "start": 150.19,
  "end": 152.61,
  "text": "Don't call. Busy.\""
 },
 {
  "i": 48,
  "w0": 298,
  "w1": 308,
  "start": 153.67,
  "end": 157.01,
  "text": "And then, like a cherry on top of the stress sundae:"
 },
 {
  "i": 49,
  "w0": 309,
  "w1": 312,
  "start": 157.01,
  "end": 160.34,
  "text": "\"Also send tracking immediately.\""
 },
 {
  "i": 50,
  "w0": 313,
  "w1": 320,
  "start": 161.42,
  "end": 164.52,
  "text": "My brain starts listing every horror story I've"
 },
 {
  "i": 51,
  "w0": 321,
  "w1": 326,
  "start": 164.53,
  "end": 168.7,
  "text": "ever read: chargebacks, fake cards, \"delivered\""
 },
 {
  "i": 52,
  "w0": 327,
  "w1": 333,
  "start": 168.71,
  "end": 171.85,
  "text": "disputes, the classic \"I never received it\""
 },
 {
  "i": 53,
  "w0": 334,
  "w1": 342,
  "start": 171.86,
  "end": 175.35,
  "text": "performance. I walk to my living room, which is"
 },
 {
  "i": 54,
  "w0": 343,
  "w1": 351,
  "start": 175.36,
  "end": 178.24,
  "text": "also my office, which is also my dining room."
 },
 {
  "i": 55,
  "w0": 352,
  "w1": 360,
  "start": 178.24,
  "end": 181.6,
  "text": "And I do the thing every entrepreneur does when"
 },
 {
  "i": 56,
  "w0": 361,
  "w1": 368,
  "start": 181.61,
  "end": 184.92,
  "text": "faced with danger: I call my friend Maya."
 },
 {
  "i": 57,
  "w0": 369,
  "w1": 375,
  "start": 184.92,
  "end": 187.69,
  "text": "Maya picks up on the second ring."
 },
 {
  "i": 58,
  "w0": 376,
  "w1": 385,
  "start": 188.48,
  "end": 190.83,
  "text": "\"If this is about your plants again, I told you:"
 },
 {
  "i": 59,
  "w0": 386,
  "w1": 392,
  "start": 190.99,
  "end": 192.61,
  "text": "talking to them doesn't count as marketing.\""
 },
 {
  "i": 60,
  "w0": 393,
  "w1": 398,
  "start": 192.61,
  "end": 197.05,
  "text": "\"Maya. I got a twelve-thousand-dollar order."
 },
 {
  "i": 61,
  "w0": 399,
  "w1": 405,
  "start": 197.5,
  "end": 199.73,
  "text": "And it's going to an abandoned warehouse.\""
 },
 {
  "i": 62,
  "w0": 406,
  "w1": 408,
  "start": 200.82,
  "end": 201.58,
  "text": "There's a beat."
 },
 {
  "i": 63,
  "w0": 409,
  "w1": 413,
  "start": 202.51,
  "end": 205.02,
  "text": "\"Okay. Do not ship that.\""
 },
 {
  "i": 64,
  "w0": 414,
  "w1": 418,
  "start": 205.88,
  "end": 207.08,
  "text": "\"But what if it's real?\""
 },
 {
  "i": 65,
  "w0": 419,
  "w1": 427,
  "start": 207.96,
  "end": 210.32,
  "text": "\"Then they can confirm the address like a normal"
 },
 {
  "i": 66,
  "w0": 428,
  "w1": 434,
  "start": 210.33,
  "end": 212.37,
  "text": "human and not like a movie villain.\""
 },
 {
  "i": 67,
  "w0": 435,
  "w1": 445,
  "start": 213.3,
  "end": 216.92,
  "text": "I hang up and sit back down, trying to breathe like"
 },
 {
  "i": 68,
  "w0": 446,
  "w1": 454,
  "start": 216.93,
  "end": 219.31,
  "text": "a calm person who definitely doesn't own three \"How"
 },
 {
  "i": 69,
  "w0": 455,
  "w1": 458,
  "start": 219.31,
  "end": 220.87,
  "text": "to Start a Business\""
 },
 {
  "i": 70,
  "w0": 459,
  "w1": 463,
  "start": 220.88,
  "end": 223.55,
  "text": "books and zero common sense."
 },
 {
  "i": 71,
  "w0": 464,
  "w1": 470,
  "start": 224.63,
  "end": 226.59,
  "text": "I decide to do a little digging."
 },
 {
  "i": 72,
  "w0": 471,
  "w1": 475,
  "start": 227.55,
  "end": 229.4,
  "text": "First: I Google the address."
 },
 {
  "i": 73,
  "w0": 476,
  "w1": 483,
  "start": 230.12,
  "end": 234.07,
  "text": "Nothing. Second: I search the name \"Elliot Graye.\""
 },
 {
  "i": 74,
  "w0": 484,
  "w1": 487,
  "start": 234.79,
  "end": 235.81,
  "text": "I get an actor."
 },
 {
  "i": 75,
  "w0": 488,
  "w1": 495,
  "start": 235.81,
  "end": 239.23,
  "text": "A dentist. A guy selling used jet skis."
 },
 {
  "i": 76,
  "w0": 496,
  "w1": 500,
  "start": 240.3,
  "end": 242.09,
  "text": "Third: I search the email."
 },
 {
  "i": 77,
  "w0": 501,
  "w1": 503,
  "start": 242.87,
  "end": 243.99,
  "text": "It's linked to\u2026"
 },
 {
  "i": 78,
  "w0": 504,
  "w1": 507,
  "start": 244.67,
  "end": 247.72,
  "text": "nothing. My stomach drops."
 },
 {
  "i": 79,
  "w0": 508,
  "w1": 516,
  "start": 248.69,
  "end": 252.435,
  "text": "This is the part where horror movies say, \"Don't"
 },
 {
  "i": 80,
  "w0": 517,
  "w1": 519,
  "start": 252.435,
  "end": 253.684,
  "text": "open the door.\""
 },
 {
  "i": 81,
  "w0": 520,
  "w1": 524,
  "start": 253.684,
  "end": 255.31,
  "text": "Then I get another email."
 },
 {
  "i": 82,
  "w0": 525,
  "w1": 528,
  "start": 256.34,
  "end": 257.68,
  "text": "\"Why no tracking yet?\""
 },
 {
  "i": 83,
  "w0": 529,
  "w1": 535,
  "start": 258.69,
  "end": 261.05,
  "text": "It's been fourteen minutes since the order."
 },
 {
  "i": 84,
  "w0": 536,
  "w1": 540,
  "start": 261.75,
  "end": 263.56,
  "text": "I reply, keeping it polite."
 },
 {
  "i": 85,
  "w0": 541,
  "w1": 547,
  "start": 263.56,
  "end": 267.22,
  "text": "\"Hi! For high-volume orders, we confirm shipping"
 },
 {
  "i": 86,
  "w0": 548,
  "w1": 550,
  "start": 267.23,
  "end": 268.44,
  "text": "details for security."
 },
 {
  "i": 87,
  "w0": 551,
  "w1": 560,
  "start": 268.44,
  "end": 271.2,
  "text": "Could you tell me the business name at the delivery"
 },
 {
  "i": 88,
  "w0": 561,
  "w1": 565,
  "start": 271.21,
  "end": 272.71,
  "text": "location and a contact number?\""
 },
 {
  "i": 89,
  "w0": 566,
  "w1": 569,
  "start": 272.71,
  "end": 276.15,
  "text": "The response arrives instantly."
 },
 {
  "i": 90,
  "w0": 570,
  "w1": 573,
  "start": 276.15,
  "end": 279.04,
  "text": "\"No time. Ship now."
 },
 {
  "i": 91,
  "w0": 574,
  "w1": 580,
  "start": 279.04,
  "end": 283.18,
  "text": "I paid.\" Now my hands are cold."
 },
 {
  "i": 92,
  "w0": 581,
  "w1": 584,
  "start": 284.08,
  "end": 285.35,
  "text": "That's not a customer."
 },
 {
  "i": 93,
  "w0": 585,
  "w1": 587,
  "start": 285.35,
  "end": 287.27,
  "text": "That's a countdown."
 },
 {
  "i": 94,
  "w0": 588,
  "w1": 599,
  "start": 288.29,
  "end": 292.33,
  "text": "I stand up, pace in a tiny circle, and then I do"
 },
 {
  "i": 95,
  "w0": 600,
  "w1": 606,
  "start": 292.34,
  "end": 294.23,
  "text": "something I've never done in my life."
 },
 {
  "i": 96,
  "w0": 607,
  "w1": 614,
  "start": 294.41,
  "end": 298.04,
  "text": "I call the number on the payment processor."
 },
 {
  "i": 97,
  "w0": 615,
  "w1": 622,
  "start": 298.04,
  "end": 301.56,
  "text": "After being serenaded by hold music that sounds"
 },
 {
  "i": 98,
  "w0": 623,
  "w1": 629,
  "start": 301.57,
  "end": 304.44,
  "text": "like a depressed elevator, a rep answers."
 },
 {
  "i": 99,
  "w0": 630,
  "w1": 637,
  "start": 305.35,
  "end": 309.87,
  "text": "\"Hi\u2014sorry\u2014this might sound weird, but can you tell"
 },
 {
  "i": 100,
  "w0": 638,
  "w1": 643,
  "start": 309.88,
  "end": 311.43,
  "text": "me if this payment looks risky?"
 },
 {
  "i": 101,
  "w0": 644,
  "w1": 647,
  "start": 311.43,
  "end": 314.51,
  "text": "Big order, sketchy address.\""
 },
 {
  "i": 102,
  "w0": 648,
  "w1": 651,
  "start": 314.52,
  "end": 317.62,
  "text": "The rep goes quiet."
 },
 {
  "i": 103,
  "w0": 652,
  "w1": 655,
  "start": 318.76,
  "end": 320.92,
  "text": "\"I can't confirm details\u2026"
 },
 {
  "i": 104,
  "w0": 656,
  "w1": 665,
  "start": 321.5,
  "end": 325.3,
  "text": "but I can tell you this: the transaction is marked"
 },
 {
  "i": 105,
  "w0": 666,
  "w1": 671,
  "start": 325.48,
  "end": 329.36,
  "text": "'high risk.'\" My face goes hot."
 },
 {
  "i": 106,
  "w0": 672,
  "w1": 678,
  "start": 330.26,
  "end": 334.96,
  "text": "\"So\u2026 scam.\" \"It could be fraud, yes.\""
 },
 {
  "i": 107,
  "w0": 679,
  "w1": 689,
  "start": 335.98,
  "end": 339.47,
  "text": "I thank them, hang up, and stare at my screen like"
 },
 {
  "i": 108,
  "w0": 690,
  "w1": 693,
  "start": 339.47,
  "end": 340.08,
  "text": "it betrayed me personally."
 },
 {
  "i": 109,
  "w0": 694,
  "w1": 697,
  "start": 341.77,
  "end": 343.57,
  "text": "Then another email hits."
 },
 {
  "i": 110,
  "w0": 698,
  "w1": 708,
  "start": 344.43,
  "end": 347.82,
  "text": "\"If you don't ship in 1 hour I will report you."
 },
 {
  "i": 111,
  "w0": 709,
  "w1": 711,
  "start": 348.13,
  "end": 349.72,
  "text": "Refund me now.\""
 },
 {
  "i": 112,
  "w0": 712,
  "w1": 714,
  "start": 350.69,
  "end": 351.55,
  "text": "I blink. Wait."
 },
 {
  "i": 113,
  "w0": 715,
  "w1": 719,
  "start": 351.55,
  "end": 354.97,
  "text": "They want a refund now?"
 },
 {
  "i": 114,
  "w0": 720,
  "w1": 727,
  "start": 355.96,
  "end": 358.67,
  "text": "That's when it clicks\u2014like a puzzle piece snapping"
 },
 {
  "i": 115,
  "w0": 728,
  "w1": 733,
  "start": 358.68,
  "end": 361.87,
  "text": "into place. This isn't about planners."
 },
 {
  "i": 116,
  "w0": 734,
  "w1": 736,
  "start": 361.87,
  "end": 363.74,
  "text": "It's about pressure."
 },
 {
  "i": 117,
  "w0": 737,
  "w1": 744,
  "start": 364.71,
  "end": 367.32,
  "text": "They want me to panic and hit \"refund,\""
 },
 {
  "i": 118,
  "w0": 745,
  "w1": 753,
  "start": 367.75,
  "end": 370.08,
  "text": "and maybe they've already set up some trick where"
 },
 {
  "i": 119,
  "w0": 754,
  "w1": 758,
  "start": 370.08,
  "end": 371.9,
  "text": "the money goes somewhere else."
 },
 {
  "i": 120,
  "w0": 759,
  "w1": 769,
  "start": 372.75,
  "end": 375.2,
  "text": "Or they want proof of shipment so they can win a"
 },
 {
  "i": 121,
  "w0": 770,
  "w1": 777,
  "start": 375.21,
  "end": 379.38,
  "text": "dispute. Either way, I'm not becoming a cautionary"
 },
 {
  "i": 122,
  "w0": 778,
  "w1": 781,
  "start": 379.39,
  "end": 380.42,
  "text": "tale on the internet."
 },
 {
  "i": 123,
  "w0": 782,
  "w1": 784,
  "start": 381.23,
  "end": 382.18,
  "text": "I type back."
 },
 {
  "i": 124,
  "w0": 785,
  "w1": 788,
  "start": 383.429,
  "end": 384.539,
  "text": "\"Thanks for your message."
 },
 {
  "i": 125,
  "w0": 789,
  "w1": 796,
  "start": 384.539,
  "end": 388.389,
  "text": "Due to security policy, we require address verification"
 },
 {
  "i": 126,
  "w0": 797,
  "w1": 799,
  "start": 388.399,
  "end": 389.709,
  "text": "for high-value orders."
 },
 {
  "i": 127,
  "w0": 800,
  "w1": 809,
  "start": 390.529,
  "end": 392.989,
  "text": "If you prefer, I can cancel and the payment will"
 },
 {
  "i": 128,
  "w0": 810,
  "w1": 813,
  "start": 392.999,
  "end": 395.539,
  "text": "be voided.\" Not refunded."
 },
 {
  "i": 129,
  "w0": 814,
  "w1": 817,
  "start": 395.539,
  "end": 398.789,
  "text": "Voided. Two minutes pass."
 },
 {
  "i": 130,
  "w0": 818,
  "w1": 824,
  "start": 399.749,
  "end": 401.419,
  "text": "Then I get a reply that is\u2026"
 },
 {
  "i": 131,
  "w0": 825,
  "w1": 828,
  "start": 402.139,
  "end": 405.429,
  "text": "unhinged. \"YOU WILL SHIP."
 },
 {
  "i": 132,
  "w0": 829,
  "w1": 833,
  "start": 405.429,
  "end": 406.029,
  "text": "I KNOW WHERE YOU LIVE.\""
 },
 {
  "i": 133,
  "w0": 834,
  "w1": 844,
  "start": 406.029,
  "end": 411.259,
  "text": "I laugh, but it comes out like fear wearing a comedy"
 },
 {
  "i": 134,
  "w0": 845,
  "w1": 848,
  "start": 411.259,
  "end": 414.879,
  "text": "mask. Because\u2014no, you don't."
 },
 {
  "i": 135,
  "w0": 849,
  "w1": 853,
  "start": 414.879,
  "end": 417.969,
  "text": "But also\u2014WHY ARE YOU YELLING?"
 },
 {
  "i": 136,
  "w0": 854,
  "w1": 857,
  "start": 419.049,
  "end": 420.229,
  "text": "I take a screenshot."
 },
 {
  "i": 137,
  "w0": 858,
  "w1": 866,
  "start": 420.669,
  "end": 423.339,
  "text": "Then another. Then I cancel the order through the"
 },
 {
  "i": 138,
  "w0": 867,
  "w1": 872,
  "start": 423.349,
  "end": 425.579,
  "text": "processor as a suspected fraud attempt."
 },
 {
  "i": 139,
  "w0": 873,
  "w1": 876,
  "start": 426.619,
  "end": 429.129,
  "text": "The dashboard updates: cancelled."
 },
 {
  "i": 140,
  "w0": 877,
  "w1": 880,
  "start": 429.489,
  "end": 431.619,
  "text": "Funds reversed. No shipment."
 },
 {
  "i": 141,
  "w0": 881,
  "w1": 884,
  "start": 432.699,
  "end": 434.009,
  "text": "I should feel relieved."
 },
 {
  "i": 142,
  "w0": 885,
  "w1": 888,
  "start": 434.009,
  "end": 436.199,
  "text": "But instead, I feel\u2026"
 },
 {
  "i": 143,
  "w0": 889,
  "w1": 897,
  "start": 436.199,
  "end": 441.279,
  "text": "shaky. Like I just stepped off a moving train."
 },
 {
  "i": 144,
  "w0": 898,
  "w1": 904,
  "start": 441.279,
  "end": 443.949,
  "text": "And that's when I notice something else."
 },
 {
  "i": 145,
  "w0": 905,
  "w1": 908,
  "start": 444.779,
  "end": 446.449,
  "text": "My site traffic spikes."
 },
 {
  "i": 146,
  "w0": 909,
  "w1": 911,
  "start": 446.449,
  "end": 447.429,
  "text": "Like, a lot."
 },
 {
  "i": 147,
  "w0": 912,
  "w1": 914,
  "start": 448.249,
  "end": 450.719,
  "text": "I open analytics."
 },
 {
  "i": 148,
  "w0": 915,
  "w1": 917,
  "start": 450.719,
  "end": 452.469,
  "text": "Hundreds of visitors\u2026"
 },
 {
  "i": 149,
  "w0": 918,
  "w1": 922,
  "start": 452.469,
  "end": 454.349,
  "text": "all hitting my checkout page."
 },
 {
  "i": 150,
  "w0": 923,
  "w1": 925,
  "start": 454.349,
  "end": 455.509,
  "text": "Over and over."
 },
 {
  "i": 151,
  "w0": 926,
  "w1": 928,
  "start": 457.449,
  "end": 458.619,
  "text": "My throat tightens."
 },
 {
  "i": 152,
  "w0": 929,
  "w1": 932,
  "start": 459.669,
  "end": 461.149,
  "text": "They're testing my store."
 },
 {
  "i": 153,
  "w0": 933,
  "w1": 935,
  "start": 461.869,
  "end": 463.179,
  "text": "Trying different cards."
 },
 {
  "i": 154,
  "w0": 936,
  "w1": 940,
  "start": 463.179,
  "end": 466.329,
  "text": "Different names. Seeing what sticks."
 },
 {
  "i": 155,
  "w0": 941,
  "w1": 951,
  "start": 466.329,
  "end": 472.619,
  "text": "I whisper to myself: \"Oh my god, I'm a vending machine"
 },
 {
  "i": 156,
  "w0": 952,
  "w1": 959,
  "start": 472.629,
  "end": 476.319,
  "text": "to them.\" I do the fastest \"entrepreneur bootcamp\""
 },
 {
  "i": 157,
  "w0": 960,
  "w1": 970,
  "start": 476.319,
  "end": 480.069,
  "text": "of my life in the next twenty minutes: I turn on"
 },
 {
  "i": 158,
  "w0": 971,
  "w1": 973,
  "start": 480.069,
  "end": 481.179,
  "text": "stricter fraud filters."
 },
 {
  "i": 159,
  "w0": 974,
  "w1": 977,
  "start": 481.179,
  "end": 481.659,
  "text": "I block certain regions."
 },
 {
  "i": 160,
  "w0": 978,
  "w1": 981,
  "start": 482.119,
  "end": 484.609,
  "text": "I add address verification."
 },
 {
  "i": 161,
  "w0": 982,
  "w1": 986,
  "start": 485.129,
  "end": 487.409,
  "text": "I disable bulk quantities temporarily."
 },
 {
  "i": 162,
  "w0": 987,
  "w1": 990,
  "start": 487.869,
  "end": 488.839,
  "text": "I add a captcha."
 },
 {
  "i": 163,
  "w0": 991,
  "w1": 997,
  "start": 489.869,
  "end": 494.219,
  "text": "I breathe. Then, finally, the traffic drops."
 },
 {
  "i": 164,
  "w0": 998,
  "w1": 1006,
  "start": 494.219,
  "end": 499.549,
  "text": "Silence returns. I sit there, hands on the keyboard,"
 },
 {
  "i": 165,
  "w0": 1007,
  "w1": 1011,
  "start": 499.919,
  "end": 502.919,
  "text": "and I start laughing\u2014real laughing."
 },
 {
  "i": 166,
  "w0": 1012,
  "w1": 1015,
  "start": 503.739,
  "end": 504.989,
  "text": "Not because it's funny\u2026"
 },
 {
  "i": 167,
  "w0": 1016,
  "w1": 1021,
  "start": 504.989,
  "end": 506.549,
  "text": "but because I genuinely thought entrepreneurship"
 },
 {
  "i": 168,
  "w0": 1022,
  "w1": 1030,
  "start": 506.559,
  "end": 510.409,
  "text": "was going to be, like, choosing brand colors and"
 },
 {
  "i": 169,
  "w0": 1031,
  "w1": 1033,
  "start": 510.419,
  "end": 512.649,
  "text": "posting motivational quotes."
 },
 {
  "i": 170,
  "w0": 1034,
  "w1": 1041,
  "start": 513.649,
  "end": 517.299,
  "text": "Turns out it's also occasionally wrestling a cyber-goblin"
 },
 {
  "i": 171,
  "w0": 1042,
  "w1": 1044,
  "start": 517.309,
  "end": 518.239,
  "text": "at 2 a.m."
 },
 {
  "i": 172,
  "w0": 1045,
  "w1": 1047,
  "start": 518.239,
  "end": 519.259,
  "text": "in pajama pants."
 },
 {
  "i": 173,
  "w0": 1048,
  "w1": 1057,
  "start": 520.589,
  "end": 523.489,
  "text": "The next morning, I wake up to one new email."
 },
 {
  "i": 174,
  "w0": 1058,
  "w1": 1062,
  "start": 524.049,
  "end": 527.329,
  "text": "Subject line: \"Order Inquiry (Legit)\""
 },
 {
  "i": 175,
  "w0": 1063,
  "w1": 1066,
  "start": 528.339,
  "end": 529.659,
  "text": "I open it cautiously."
 },
 {
  "i": 176,
  "w0": 1067,
  "w1": 1072,
  "start": 529.659,
  "end": 532.809,
  "text": "\"Hi! I run a coworking space."
 },
 {
  "i": 177,
  "w0": 1073,
  "w1": 1079,
  "start": 532.809,
  "end": 535.449,
  "text": "We want 200 planners with our logo."
 },
 {
  "i": 178,
  "w0": 1080,
  "w1": 1082,
  "start": 535.989,
  "end": 537.341,
  "text": "Can we talk?\""
 },
 {
  "i": 179,
  "w0": 1083,
  "w1": 1086,
  "start": 537.341,
  "end": 539.145,
  "text": "I stare at it."
 },
 {
  "i": 180,
  "w0": 1087,
  "w1": 1089,
  "start": 539.145,
  "end": 540.219,
  "text": "My eye twitches."
 },
 {
  "i": 181,
  "w0": 1090,
  "w1": 1098,
  "start": 541.329,
  "end": 545.219,
  "text": "\"Sure. Totally. Let me just recover from last night's"
 },
 {
  "i": 182,
  "w0": 1099,
  "w1": 1105,
  "start": 545.229,
  "end": 548.419,
  "text": "villain arc.\" We hop on a call."
 },
 {
  "i": 183,
  "w0": 1106,
  "w1": 1109,
  "start": 548.639,
  "end": 549.509,
  "text": "They're real. They're friendly."
 },
 {
  "i": 184,
  "w0": 1110,
  "w1": 1114,
  "start": 551.109,
  "end": 552.369,
  "text": "They laugh at my jokes."
 },
 {
  "i": 185,
  "w0": 1115,
  "w1": 1124,
  "start": 553.189,
  "end": 556.409,
  "text": "They have a website and a phone number and\u2014get this\u2014a"
 },
 {
  "i": 186,
  "w0": 1125,
  "w1": 1130,
  "start": 556.419,
  "end": 558.349,
  "text": "normal address with a front door."
 },
 {
  "i": 187,
  "w0": 1131,
  "w1": 1134,
  "start": 558.349,
  "end": 558.829,
  "text": "I fulfill the order."
 },
 {
  "i": 188,
  "w0": 1135,
  "w1": 1137,
  "start": 559.909,
  "end": 560.659,
  "text": "It goes smoothly."
 },
 {
  "i": 189,
  "w0": 1138,
  "w1": 1142,
  "start": 562.719,
  "end": 564.339,
  "text": "They reorder the next month."
 },
 {
  "i": 190,
  "w0": 1143,
  "w1": 1149,
  "start": 564.339,
  "end": 568.069,
  "text": "And here's the twist: That scam attempt?"
 },
 {
  "i": 191,
  "w0": 1150,
  "w1": 1154,
  "start": 568.069,
  "end": 570.379,
  "text": "It didn't just scare me."
 },
 {
  "i": 192,
  "w0": 1155,
  "w1": 1157,
  "start": 570.379,
  "end": 572.079,
  "text": "It upgraded me."
 },
 {
  "i": 193,
  "w0": 1158,
  "w1": 1165,
  "start": 572.939,
  "end": 576.569,
  "text": "Because I realized something important: if my tiny"
 },
 {
  "i": 194,
  "w0": 1166,
  "w1": 1172,
  "start": 576.579,
  "end": 579.149,
  "text": "little planner shop could attract fraudsters, it"
 },
 {
  "i": 195,
  "w0": 1173,
  "w1": 1181,
  "start": 579.149,
  "end": 582.309,
  "text": "meant I'd built something real enough to be targeted."
 },
 {
  "i": 196,
  "w0": 1182,
  "w1": 1189,
  "start": 583.399,
  "end": 585.649,
  "text": "So I changed how I ran my business."
 },
 {
  "i": 197,
  "w0": 1190,
  "w1": 1194,
  "start": 585.649,
  "end": 588.079,
  "text": "I built simple security rules."
 },
 {
  "i": 198,
  "w0": 1195,
  "w1": 1200,
  "start": 588.079,
  "end": 590.429,
  "text": "I wrote policies in plain English."
 },
 {
  "i": 199,
  "w0": 1201,
  "w1": 1205,
  "start": 590.429,
  "end": 592.119,
  "text": "I stopped worshipping \"big numbers\""
 },
 {
  "i": 200,
  "w0": 1206,
  "w1": 1209,
  "start": 592.129,
  "end": 595.379,
  "text": "and started verifying reality."
 },
 {
  "i": 201,
  "w0": 1210,
  "w1": 1213,
  "start": 596.239,
  "end": 597.449,
  "text": "And the funniest part?"
 },
 {
  "i": 202,
  "w0": 1214,
  "w1": 1223,
  "start": 598.189,
  "end": 601.039,
  "text": "A few months later, a friend asked, \"How did you"
 },
 {
  "i": 203,
  "w0": 1224,
  "w1": 1228,
  "start": 601.049,
  "end": 602.539,
  "text": "learn fraud prevention so fast?\""
 },
 {
  "i": 204,
  "w0": 1229,
  "w1": 1236,
  "start": 602.539,
  "end": 606.009,
  "text": "I said, \"By almost donating twelve thousand dollars"
 },
 {
  "i": 205,
  "w0": 1237,
  "w1": 1243,
  "start": 606.019,
  "end": 609.699,
  "text": "worth of planners to a raccoon warehouse.\""
 },
 {
  "i": 206,
  "w0": 1244,
  "w1": 1250,
  "start": 609.699,
  "end": 613.969,
  "text": "Look\u2014if you're building something, the wins feel"
 },
 {
  "i": 207,
  "w0": 1251,
  "w1": 1254,
  "start": 613.979,
  "end": 616.529,
  "text": "amazing. But the near-misses?"
 },
 {
  "i": 208,
  "w0": 1255,
  "w1": 1263,
  "start": 616.529,
  "end": 620.019,
  "text": "Those are the moments you actually become the person"
 },
 {
  "i": 209,
  "w0": 1264,
  "w1": 1268,
  "start": 620.029,
  "end": 621.529,
  "text": "who can handle the wins."
 },
 {
  "i": 210,
  "w0": 1269,
  "w1": 1279,
  "start": 622.579,
  "end": 626.119,
  "text": "And if you ever get a massive order at 2:07 a.m."
 },
 {
  "i": 211,
  "w0": 1280,
  "w1": 1283,
  "start": 626.119,
  "end": 627.699,
  "text": "to an abandoned warehouse\u2026"
 },
 {
  "i": 212,
  "w0": 1284,
  "w1": 1286,
  "start": 629.049,
  "end": 629.939,
  "text": "Don't ship it."
 },
 {
  "i": 213,
  "w0": 1287,
  "w1": 1290,
  "start": 629.939,
  "end": 632.259,
  "text": "Ship your spine first."
 }
]